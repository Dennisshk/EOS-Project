set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)

# Compiler
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

set(CROSS_PREFIX aarch64-none-elf)
get_filename_component(TOOLCHAIN_BIN_DIR "${CMAKE_CURRENT_LIST_DIR}/compiler/bin" ABSOLUTE)

set(CMAKE_C_COMPILER   "${TOOLCHAIN_BIN_DIR}/${CROSS_PREFIX}-gcc")
set(CMAKE_CXX_COMPILER "${TOOLCHAIN_BIN_DIR}/${CROSS_PREFIX}-g++")
set(CMAKE_ASM_COMPILER "${TOOLCHAIN_BIN_DIR}/${CROSS_PREFIX}-gcc")

# Binutils
set(CMAKE_AR      "${TOOLCHAIN_BIN_DIR}/${CROSS_PREFIX}-ar")
set(CMAKE_RANLIB  "${TOOLCHAIN_BIN_DIR}/${CROSS_PREFIX}-ranlib")
set(CMAKE_OBJCOPY "${TOOLCHAIN_BIN_DIR}/${CROSS_PREFIX}-objcopy")
set(CMAKE_SIZE    "${TOOLCHAIN_BIN_DIR}/${CROSS_PREFIX}-size")

# Library/Include/Package search paths
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

# Set architecture name
set(ARCH_NAME "aarch64")
